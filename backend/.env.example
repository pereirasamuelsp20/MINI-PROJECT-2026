# Disaster Mesh Backend — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env with real secrets.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://mesh_user:CHANGE_ME@localhost:5432/disaster_mesh

# ─── Server ─────────────────────────────────────────────────
LISTEN_ADDR=0.0.0.0:3001
RUST_LOG=disaster_mesh_server=debug,tower_http=debug

# ─── JWT Authentication ─────────────────────────────────────
# Minimum 64 characters of cryptographically random hex.
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ACCESS_TOKEN_EXPIRY_SECS=3600
JWT_REFRESH_TOKEN_EXPIRY_SECS=604800

# ─── Gateway API Key Authentication ─────────────────────────
# HMAC secret used to verify gateway API keys.
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_SECS=60

# ─── Protocol Limits ────────────────────────────────────────
MAX_PACKET_SIZE_BYTES=512
MAX_INGEST_BATCH_SIZE=50
